<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Relationship Path Sample</label>
    <decisions>
        <name>Check_State</name>
        <label>Check State</label>
        <rules>
            <name>State_Match</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.BillingState</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NY</stringValue>
                </rightValue>
            </conditions>
        </rules>
    </decisions>
    <formulas>
        <name>Flag_Label</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.ns__RelatedObject__r.Status__c})</expression>
    </formulas>
    <recordLookups>
        <name>Get_Related</name>
        <label>Get Related</label>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ns__RelatedObject__r.Id</elementReference>
            </value>
        </filters>
        <object>RelatedObject__c</object>
    </recordLookups>
    <start>
        <object>SampleObject__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
</Flow>